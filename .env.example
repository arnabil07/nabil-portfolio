# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Contact form uses Resend (https://resend.com). Without these, the form tells visitors it is
# not connected and offers a mailto fallback (once you set contact.email in data/profile.ts).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain you verified in Resend, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
